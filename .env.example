# ── Groq (email classification — groq.com, OpenAI-compatible) ────────────────
GROQ_API_KEY=gsk_...
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# ── Google Service Account (Gmail newsletter scraper — sm@gototeam.com) ───────
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./config/google-service-account.json
GMAIL_NEWSLETTER_USER=sm@gototeam.com
GMAIL_NEWSLETTER_LABEL=Label_378

# ── Gmail OAuth (pipeline email poller — Shawn's account) ────────────────────
# Run the one-time OAuth flow then paste the refresh token here
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
PIPELINE_POLL_INTERVAL_SECONDS=900

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Show Pitch Machine
DATABASE_PATH=./data/db.sqlite
VECTORS_PATH=./data/vectors
LOGS_PATH=./logs
PDF_OUTPUT_PATH=./data/pdfs
BACKUP_PATH=./data/backups

# ── Browser / CDP ─────────────────────────────────────────────────────────────
# bang-tunnel: Patrick's machine — routes through Bang (10.0.0.208) via SSH
# local: Shawn's machine — connects to localhost:9222 or launches headless Chrome
BROWSER_MODE=local
CDP_PORT=9222

# ── Bang Machine (only when BROWSER_MODE=bang-tunnel) ─────────────────────────
BANG_HOST=10.0.0.208
BANG_USER=BubbaBang
BANG_CHROME_PORT=9222
BANG_LOCAL_TUNNEL_PORT=19223

# ── TMDB (streaming seed — themoviedb.org/settings/api) ──────────────────────
TMDB_API_KEY=

# ── Scraper ───────────────────────────────────────────────────────────────────
SCRAPER_ENABLED=true
SCRAPER_CRON=0 6 * * *
SCRAPER_RATE_LIMIT_MS=2000
SCRAPER_RETRY_COUNT=3

# ── MCP Server ────────────────────────────────────────────────────────────────
MCP_PORT=3001

# ── Google Drive Video Storage (sizzle reels) ─────────────────────────────────
# Folder ID for the "Sizzle Reels" folder in myentprod.com Drive.
# If not set, the upload API will create the folder automatically on first upload.
DRIVE_SIZZLE_FOLDER_ID=

# ── Conversion Export Feed (GET /api/export/conversions) ──────────────────────
# Bearer token required to access the PII-free keyword→conversion export endpoint.
# Set this in Railway before using the feed. Generate with: openssl rand -hex 32
# NEVER commit the actual token — only this placeholder belongs in .env.example.
CONV_EXPORT_TOKEN=

# ── Industry Data Subscriptions (Billboard / Getty scrapers) ──────────────────
# Real values live in .env / .env.local only (gitignored). Placeholders here.
BILLBOARD_EMAIL=
BILLBOARD_PASSWORD=
GETTY_EMAIL=
GETTY_PASSWORD=

# ── Getty Images API (license-safe, on-demand deck imagery — see docs/getty-integration.md) ──
# NOTE: API access requires OAuth client_id/secret from a Getty account manager.
# The website login credentials above (GETTY_EMAIL/GETTY_PASSWORD) are NOT API access.
# Contact a Getty account manager for the Kmiles@myentprod.com account to provision these.
GETTY_API_KEY=
GETTY_API_SECRET=
