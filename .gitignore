# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# runtime data — database, vectors, generated PDFs, logs
/data/
/logs/
*.sqlite
*.db
show-pitch.db

# mcp-server build artifacts
/mcp-server/node_modules/
/mcp-server/dist/
/mcp-server/.env

# one-off Railway deployment scripts (contain hardcoded tokens)
railway-*.js
data/vimeo-backfill-tmp/
